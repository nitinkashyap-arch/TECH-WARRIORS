# ==============================================================================
# Campus Cybersecurity Threat Detection System - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Secrets & Sensitive Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets.yaml
secrets.json
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 2. Python & Bytecode Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 3. Python Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.conda/

# ------------------------------------------------------------------------------
# 4. Testing, Linting & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml
*.cover

# ------------------------------------------------------------------------------
# 5. React / Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.next/
out/
dist/
dist-ssr/
*.local

# ------------------------------------------------------------------------------
# 6. Large Datasets & Packet Capture Dumps (PCAPs)
# ------------------------------------------------------------------------------
# Prevent committing multi-gigabyte PCAP files or raw training datasets
*.pcap
*.pcapng
*.cap
*.dmp
data/raw/
data/processed/
datasets/
!data/samples/

# ------------------------------------------------------------------------------
# 7. Machine Learning Model Artifacts
# ------------------------------------------------------------------------------
# Keep tracking models directory but ignore large generated model weights
backend/models/*.joblib
backend/models/*.pkl
backend/models/*.h5
backend/models/*.onnx
!backend/models/.gitkeep

# ------------------------------------------------------------------------------
# 8. Logs & Databases
# ------------------------------------------------------------------------------
*.log
logs/
*.sqlite
*.sqlite3
*.db
pgdata/

# ------------------------------------------------------------------------------
# 9. IDEs & Operating System Artifacts
# ------------------------------------------------------------------------------
# JetBrains (PyCharm / WebStorm)
.idea/
*.iws
*.iml

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
